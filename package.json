{
	"name": "monorepo-ssr",
	"type": "module",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"setup": "bun install",
		"dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\"",
		"build": "concurrently --raw \"npm run build --prefix apps/web\"",
		"start": "concurrently --kill-others --raw \"npm run start --prefix apps/web\"",
		"lint": "concurrently --raw \"npm run lint --prefix apps/web\"",
		"typecheck": "concurrently --raw \"npm run typecheck --prefix apps/web\""
	},
	"devDependencies": {
		"browserslist": "^4.29.5",
		"caniuse-lite": "^1.0.30001820",
		"concurrently": "^10.0.6",
		"knip": "^6.32.1",
		"lodash": "^4.18.1"
	},
	"workspaces": [
		"apps/*"
	]
}
